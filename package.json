{
  "name": "critical-stop-1612",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "description": "实时 3D 高速公路刹车试验与法庭剧情",
  "author": "V800",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "desktop:run": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --win --dir",
    "desktop:dist": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "electron": "43.7.9",
    "electron-builder": "26.15.3",
    "vite": "^7.1.7"
  },
  "build": {
    "appId": "local.criticalstop1612.game",
    "productName": "1612 临界刹停",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json",
      "!node_modules{,/**/*}"
    ],
    "win": {
      "icon": "desktop/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "1612-Critical-Stop-${version}-Windows-x64.${ext}"
    },
    "portable": {
      "requestExecutionLevel": "user"
    }
  }
}
